<?xml version="1.0" encoding="utf-8"?>
<!-- Gamepad launcher icon, API 26+. Plate and art both have -night variants, so the icon follows the
     system light/dark setting. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_pad_bg" />
    <foreground android:drawable="@drawable/ic_pad_fg" />
    <monochrome android:drawable="@drawable/ic_pad_fg_mono" />
</adaptive-icon>
