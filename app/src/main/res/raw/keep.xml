<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource-shrinker keep rules.

  The intro clip and the preview clips are referenced from Kotlin through R.raw.*, and
  R8 inlines those ints during a release build. A cold resource-shrinker pass then sees
  them as unused and drops ~12 MB of media — which is exactly what happened to the
  v6.7.0 build (19.4 MB -> 7.4 MB, intro video silently gone). Keeping them explicitly
  here makes the shrinker deterministic.

  The launcher icons are kept by name too: the manifest reaches them only through
  <activity-alias> entries, and an alias the user has switched *off* still has to
  resolve its icon before it can be switched back on.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/intro_portrait,@raw/game_space_intro,@raw/intro_gamepad,@raw/preview_color,@raw/preview_scale,@raw/preview_sharpen,@drawable/intro_gamepad,@drawable/ic_pad_fg,@drawable/ic_pad_fg_dark,@drawable/ic_pad_fg_light,@drawable/ic_pad_fg_mono,@drawable/ic_pad_mark,@drawable/ic_pad_mark_mono,@drawable/ic_stat_gh,@drawable/ic_pick_auto,@drawable/ic_pick_dark,@drawable/ic_pick_light,@drawable/ic_pick_mono,@mipmap/ic_launcher,@mipmap/ic_launcher_round,@mipmap/ic_launcher_pad,@mipmap/ic_launcher_pad_round,@mipmap/ic_launcher_pad_dark,@mipmap/ic_launcher_pad_dark_round,@mipmap/ic_launcher_pad_light,@mipmap/ic_launcher_pad_light_round,@mipmap/ic_launcher_pad_mono,@mipmap/ic_launcher_pad_mono_round,@drawable/ic_launcher_foreground,@drawable/ic_launcher_background,@drawable/ic_launcher_mono" />
